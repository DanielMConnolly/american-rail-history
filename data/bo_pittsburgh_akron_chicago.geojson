{"type": "FeatureCollection", "features": [{"type": "Feature", "properties": {"company": "Amtrak", "line": "Amtrak: Broadway Limited (Pittsburgh \u2013 Chicago, ex-B&O)", "id": "amtrak-broadway-limited-akron-reroute", "color": "#1c4e80", "mode": "intercity_rail", "avg_speed_kmh": 75, "speed_source": "estimated, consistent with contemporary Amtrak long-distance schedules; unsourced", "segments": [{"start": 1990, "end": 1995, "headway_min": 720, "note": "This Pittsburgh-Chicago segment follows the ex-B&O route via Akron: the Pittsburgh & Western Railroad reached Akron from Pittsburgh in 1884 (leased permanently to the B&O July 1, 1890), continuing via the Akron & Chicago Junction Railroad (completed 1891) to Willard (Chicago Junction), then the older Baltimore & Ohio & Chicago Railroad (completed 1874) on to Chicago. On Nov 10, 1990 Amtrak rerouted the Broadway Limited off its traditional ex-PRR routing west of Pittsburgh onto this ex-B&O line, restoring Akron's only Amtrak service (Akron station reopened for this train). Continues from Philadelphia-Pittsburgh via the Broadway Limited entry in pennsylvania_railroad.geojson.", "sources": ["NOT SOURCED AT SEGMENT LEVEL: the references below cover this line, but nothing has been checked specifically against this segment's start year, end year or service. Treat the dates and the headway as unverified. Supporting references for the line:", "https://en.wikipedia.org/wiki/Baltimore_and_Ohio_Chicago_Terminal_Railroad", "https://en.wikipedia.org/wiki/Baltimore_and_Ohio_Railroad"]}], "geometry_repairs": [{"date": "2026-08-29", "from": [-87.3370646, 41.6020962], "to": [-87.6244212, 41.8755616], "chord_mi": 24.09, "traced_mi": 28.99, "snap_m": [272, 117], "bridged_mi": 0.08, "osm_lines": ["University Park Sub District (7.46 mi)", "NS Chicago Line (6.48 mi)", "South Chicago Sub District (4.77 mi)", "South Shore Line [abandoned] (3.45 mi)", "NICTD South Shore Line (3.42 mi)", "Kankakee Line (1.79 mi)"], "method": "Overpass rail gra