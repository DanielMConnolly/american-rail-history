     },
     {
      "start": 1996,
      "end": 2020,
      "headway_min": 60,
      "note": "Service grew to about 18 weekday round trips before COVID; State Street station in New Haven opened June 7 2002, per Wikipedia. Amtrak track work and a locomotive shortage forced partial bus substitution in 2018-19, with full service back August 5 2019. Headway estimated from the pre-COVID round-trip count.",
      "sources": [
       "Segment-level: this segment's own note names the source for its dates and service; the headway is an estimate, not counted from a timetable.",
       "https://en.wikipedia.org/wiki/Shore_Line_East"
