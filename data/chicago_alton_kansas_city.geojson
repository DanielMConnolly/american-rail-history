, [-94.4606666, 39.0919104], [-94.4612887, 39.09807], [-94.4660728, 39.1026723], [-94.467817, 39.107678], [-94.4712433, 39.1104425], [-94.4792088, 39.1132898], [-94.483734, 39.11472], [-94.4966694, 39.1158535], [-94.5070863, 39.1204528], [-94.5182777, 39.1218799], [-94.5434834, 39.118948], [-94.5689163, 39.113942], [-94.574249, 39.1134426]]}, "properties": {"company": "Chicago and Alton Railroad", "line": "Chicago and Alton: Chicago \u2013 Kansas City", "id": "ca-chicago-kansas-city", "color": "#5B7C99", "mode": "intercity_rail", "avg_speed_kmh": 60, "speed_source": "Estimated, not sourced: no Chicago & Alton timetable was consulted for this route. 60 km/h is a whole-route guess for an overnight train making many stops.", "geometry_quality": "Real-traced from OpenStreetMap. Built by chaining the ways of eight named ex-Alton subdivisions that still carry old_railway_operator=GM&O -- Joliet Subdivision in three pieces, Springfield Subdivision, CPKC Springfield Subdivision, CPKC Roodhouse Subdivision, CPKC Mexico Subdivision and KC Metro Subdivision -- which between them supply 473.6 of the 489.8 drawn miles as OSM geometry used verbatim. The named chains do not quite touch each other at Gardner, Bloomington, Springfield, Roodhouse and the Kansas City yard throat; each of those gaps was closed by a corridor-weighted shortest path over every railway way nearby, so 5 of the 6 joins are real track (8.95 km, 7.93 km, 5.30 km, 0.26 km, 1.84 km). The remaining 1 join could not be routed on mapped track and is drawn as a straight line, totalling 0.12 km: 0.12 km at [-87.9407, 41.697]. Traced length 489.8 miles against the roughly 488 route miles the Alton advertised as the shortest Chicago-Kansas City line -- a fit close enough to confirm the assembly is on the right railroad end to end. The longest straight step anywhere in the raw trace is 2.84 km, which is ordinary tangent track rather than a bridged gap, and the reversal and revisit spike detectors both come back clean. CAVEAT (CLAUDE.md Rule 2): this is the MODERN alignment -- Metra, Union Pacific and CPKC today -- drawn back to 1879. The corridor has seen little relocation, but it has not been checked against a period valuation map, and the Chicago and Kansas City terminal approaches are today's, not the 1879 ones. Straight-line repair 2026-08-29: 7 ruled segments totalling 136 mi replaced with OpenStreetMap-traced rail geometry (see geometry_repairs for the OSM lines each one followed).", "geometry_source": ["OpenStreetMap ways tagged old_railway_operator=GM&O, pulled via Overpass 2026-08-27", "Named subdivisions used: Joliet Subdivision, Springfield Subdivision, CPKC Springfield Subdivision, CPKC Roodhouse Subdivision, CPKC Mexico Subdivision, CPKC Godfrey Subdivision, KC Metro Subdivision"], "segments": [{"start": 1879, "end": 1900, "headway_min": 720, "note": "The Chicago & Alton reached Kansas City in 1879 over two leased roads: the Louisiana & Missouri River Railroad (leased 1870; its branch from Roodhouse, Ill. to Louisiana, Mo. was built in 1871) and the Kansas City, St. Louis & Chicago Railroad (leased 1878), which carried it from Mexico, Mo. through Slater to Kansas City. The Alton advertised the result as the shortest Chicago\u2013Kansas City line. Chicago\u2013Springfield ran over the existing main line, already drawn in alton_gmo_abraham_lincoln.geojson; the Kansas City line diverged at Springfield for Jacksonville and Roodhouse. headway_min of 720 stands for roughly two trains each way per day and is an estimate, not read off a timetable.", "sources": ["Segment-level: the 1870 and 1878 lease dates, the 1871 Roodhouse\u2013Louisiana branch and the 1879 completion to Kansas City are carried by the references below; the headway is NOT sourced.", "https://en.wikipedia.org/wiki/Alton_Railroad", "https://en.wikipedia.org/wiki/Gateway_Western_Railway", "https://www.american-rails.com/alton.html", "https://en.wikipedia.org/wiki/Roodhouse,_Illinois", "https://www.trains.com/ctr/railroads/fallen-flags/gulf-mobile-and-ohio-locomotives-remembered/"]}, {"start": 1900, "end": 1931, "headway_min": 600, "note": "The Hummer, an overnight Chicago\u2013Kansas City train, ran this route from the early 1900s and was well enough known to have sheet music written about it (\"The Hum of the Hummer\"). Roodhouse, the junction where the St. Louis and Chicago legs met, grew into a division point on the strength of it. headway_min is an estimate, not read off a timetable.", "sources": ["NOT SOURCED AT SEGMENT LEVEL: the Hummer is documented as an early-1900s Chicago\u2013Kansas City train, but nobody has checked a timetable for this segment's start year, end year or headway.", "https://en.wikipedia.org/wiki/Alton_Railroad", "https://en.wikipedia.org/wiki/Gateway_Western_Railway", "https://www.american-rails.com/alton.html", "https://en.wikipedia.org/wiki/Roodhouse,_Illinois", "https://www.trains.com/ctr/railroads/fallen-flags/gulf-mobile-and-ohio-locomotives-remembered/"]}, {"start": 1931, "end": 1947, "headway_min": 720, "note": "The Chicago & Alton was reorganised in 1931 as the Alton Railroad, a Baltimore & Ohio subsidiary, which ran the Kansas City line through the Depression and the Second World War. headway_min is an estimate, not read off a timetable.", "sources": ["Segment-level: the 1931 reorganisation into the B&O-controlled Alton Railroad is carried by the references below; the headway is NOT sourced.", "https://en.wikipedia.org/wiki/Alton_Railroad", "https://en.wikipedia.org/wiki/Gateway_Western_Railway", "https://www.american-rails.com/alton.html", "https://en.wikipedia.org/wiki/Roodhouse,_Illinois", "https://www.trains.com/ctr/railroads/fallen-flags/gulf-mobile-and-ohio-locomotives-remembered/"]}], "geometry_repairs": [{"date": "2026-08-29", "from": [-92.1268885, 39.2113657], "to": [-92.3418004, 39.2815403], "chord_mi": 12.44, "traced_mi": 12.49, "snap_m": [0, 0], "bridged_mi": 0.0, "osm_lines": ["CPKC Mexico Subdivision (12.49 mi)"], "metho