{"type": "FeatureCollection", "features": [{"type": "Feature", "properties": {"company": "Chicago and North Western Railway", "line": "Chicago and North Western: Chicago \u2013 Madison", "id": "cnw-chicago-milwaukee-madison", "color": "#E3B23C", "mode": "intercity_rail", "avg_speed_kmh": 55, "speed_source": "estimated: typical C&NW regional mainline service of the era; unsourced", "segments": [{"start": 1864, "end": 1882, "headway_min": 480, "note": "The Chicago and North Western reached Madison in 1864, the city's first rail connection (depot opened 1871). Frequency estimated, unsourced.", "sources": ["NOT SOURCED AT SEGMENT LEVEL: the references below cover this line, but nothing has been checked specifically against this segment's start year, end year or service. Treat the dates and the headway as unverified. Supporting references for the line:", "https://en.wikipedia.org/wiki/Chicago_and_North_Western_Railway"]}, {"start": 1882, "end": 1920, "headway_min": 150, "note": "C&NW built a direct line between Milwaukee and Madison in 1882, giving a more direct Chicago-Milwaukee-Madison route; 'scores of trains' a day connected Madison to Chicago, the Twin Cities, Rapid City, and Michigan's Upper Peninsula, with well over 100 combined freight and passenger trains a day through the city around 1900. Frequency estimated, unsourced.", "sources": ["NOT SOURCED AT SEGMENT LEVEL: the references below cover this line, but nothing has been checked specifically against this segment's start year, end year or service. Treat the dates and the headway as unverified. Supporting references for the line:", "https://en.wikipedia.org/wiki/Chicago_and_North_Western_Railway"]}, {"start": 1920, "end": 1965, "headway_min": 300, "note": "U.S. rail passenger volume peaked around 1920 before autos and buses began eroding ridership. C&NW passenger service to Madison, including later '400'-series streamliners, continued declining until it was discontinued entirely in 1965 - six years before Amtrak existed, so Madison was never part of the Amtrak system. Frequency estimated, unsourced.", "sources": ["NOT SOURCED AT SEGMENT LEVEL: the references below cover this line, but nothing has been checked specifically against this segment's start year, end year or service. Treat the dates and the headway as unverified. Supporting references for the line:", "https://en.wikipedia.org/wiki/Chicago_and_North_Western_Railway"]}], "geometry_repairs": [{"date": "2026-08-29", "from": [-88.7241822, 43.194335], "to": [-89.3841663, 43.07469], "chord_mi": 34.62, "traced_mi": 36.03, "snap_m": [773, 431], "bridged_mi": 0.87, "osm_lines": ["Wisconsin & Southern Railroad (24.47 mi)", "Wisconsin and Southern Railroad (8.83 mi)", "Reedsburg Subdivision (1.12 mi)", "(?) (0.87 mi)", "CPKC (0.38 mi)", "Rail & Transload, Inc. (0.24 mi)"], "method": "Overpass rail graph, 8.0 km corridor, Dijkstra, simplified to 3.0 m; 0.87 mi bridged across gaps in OSM"}, {"date": "2026-08-29", "from": [-87.71955, 41.90888], "to": [-87.84798, 42.16315], "chord_mi": 18.75, "traced_mi": 19.33, "snap_m": [6, 9], "bridged_mi": 0.0, "osm_lines": ["C&M Subdivision (19.05 mi)", "(rail) (0.28 mi)"], "method": "Overpass rail graph, 8.0 km corridor, Dijkstra, simplified to 3.0 m"}, {"date": "2026-08-29", "from": [-87.9171, 43.03452], "to": [-88.7241822, 43.194335], "chord_mi": 42.56, "traced_mi": 45.33, "snap_m": [64, 773], "bridged_mi": 0.0, "osm_lines": ["Watertown Subdivision (36.21 mi)", "(abandoned) [abandoned] (9.01 mi)", "Cooney Siding (0.05 mi)", "(rail) (0.05 mi)"], "method": "Overpass rail graph, 8.0 km corridor, Dijkstra, simplified to 3.0 m"}, {"date": "2026-08-29", "from": [-87.90489, 42.55275], "to": [-87.90611, 42.72184], "chord_mi": 11.68, "traced_mi": 11.7, "snap_m": [22, 2], "bridged_mi": 0.0, "osm_lines": ["C&M Subdivision (11.7 mi)"], "method": "Overpass rail graph, 8.0 km corridor, Dijkstra, simplified to 3.0 m"}], "geometry_quality": "Straight-line repair 2026-08-29: 1 ruled segment totalling 35