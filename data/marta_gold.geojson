{"type": "FeatureCollection", "features": [{"type": "Feature", "properties": {"company": "Metropolitan Atlanta Rapid Transit Authority", "line": "Metropolitan Atlanta Rapid Transit Authority: Gold Line", "id": "marta-gold-line", "color": "#0092D0", "mode": "rapid_transit", "avg_speed_kmh": 40, "speed_source": "estimated typical MARTA heavy-rail operating speed (station stops included); unsourced", "segments": [{"start": 1992, "end": 2009, "headway_min": 8, "note": "Built in stages as the North-South Line: Garnett-North Avenue opened Dec 4 1981; extended to West End Sept 11 1982 and to Arts Center/Midtown Dec 18 1982; Lindbergh Center, Lenox and Brookhaven opened Dec 15 1984 (same day the South Line's Oakland City and Lakewood/Ft. McPherson opened); East Point opened Aug 16 1986; Chamblee opened Dec 19 1987 as a temporary northern terminus; College Park and Airport opened June 18 1988, completing the southern end; Doraville opened Dec 29 1992, completing the route shown here. Combined North-South Line headway was roughly 4 minutes on the shared downtown trunk (two routes at 8-minute headways each).", "sources": ["NOT SOURCED AT SEGMENT LEVEL: the references below cover this line, but nothing has been checked specifically against this segment's start year, end year or service. Treat the dates and the headway as unverified. Supporting references for the line:", "https://en.wikipedia.org/wiki/MARTA_rail", "https://www.itsmarta.com/"]}, {"start": 2009, "end": 2010, "headway_min": 8, "note": "Renamed the Yellow Line in Oct 2009 under MARTA's new color-coding system.", "sources": ["NOT SOURCED AT SEGMENT LEVEL: the references below cover this line, but nothing has been checked specifically against this segment's start year, end year or service. Treat the dates and the headway as unverified. Supporting references for the line:", "https://en.wikipedia.org/wiki/MARTA_rail", "https://www.itsmarta.com/"]}, {"start": 2010, "end": 2026, "headway_min": 11, "note": "Renamed again to the Gold Line in Feb 2010, after community feedback from Doraville's Asian-American community objected to 'Yellow.' Shares track with the Red Line from Airport north to Lindbergh Center, where it branches northeast toward Lenox, Brookhaven, Chamblee and Doraville.", "sources": ["NOT SOURCED AT SEGMENT LEVEL: the references below cover this line, but nothing has been checked specifically against this segment's start year, end year or service. Treat the dates and the headway as unverified. Supporting references for the line:", "https://en.wikipedia.org/wiki/MARTA_rail", "https://www.itsmarta.com/"]}]}, "geometry": {"type": "LineString", "coordinates": [[-84.27923, 33.90364], [-84.27934, 33.90357], [-84.27943, 33.9035], [-84.28015, 33.903], [-84.28105, 33.90233], [-84.28203, 33.90166], [-84.28255, 33.90133], [-84.28289, 33.90111], [-84.28327, 33.90086], [-84.28415, 33.90029], [-84.28449, 33.90007], [-84.28479, 33.89986], [-84.28533, 33.89948], [-84.28677, 33.89846], [-84.28719, 33.89815], [-84.28763, 33.89786], [-84.28789, 33.89769], [-84.28816, 33.89753], [-84.28835, 33.89743], [-84.28855, 33.89733], [-84.28874, 33.89723], [-84.2891, 33.89705], [-84.28933, 33.89696], [-84.28978, 33.89676], [-84.29041, 33.89652], [-84.29131, 33.89619], [-84.29207, 33.89591], [-84.29271, 33.89564], [-84.29341, 33.89536], [-84.29437, 33.89497], [-84.29511, 33.89467], [-84.29638, 33.89415], [-84.29683, 33.89397], [-84.29723, 33.89381], [-84.29747, 33.89371], [-84.29811, 33.89343], [-84.29827, 33.89336], [-84.29832, 33.89334], [-84.29855, 33.89322], [-84.29887, 33.89305], [-84.29899, 33.89298], [-84.29926, 33.89282], [-84.29949, 33.89266], [-84.29979, 33.89243], [-84.29999, 33.89227], [-84.30012, 33.89216], [-84.30032, 33.89198], [-84.30066, 33.89166], [-84.30092, 33.8914], [-84.30111, 33.89119], [-84.30156, 33.89073], [-84.30163, 33.89066], [-84.30171, 33.89058], [-84.30187, 33.89042], [-84.3021, 33.89018], [-84.30232, 33.88995], [-84.30251, 33.88976], [-84.3028, 33.88948], [-84.30308, 