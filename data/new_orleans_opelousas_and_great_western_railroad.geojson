   "properties": {
    "company": "New Orleans, Opelousas and Great Western Railroad",
    "line": "New Orleans, Opelousas and Great Western: Algiers – Lafourche Crossing",
    "id": "noogw-algiers-lafourche-crossing",
    "color": "#6B4F3A",
    "mode": "intercity_rail",
    "avg_speed_kmh": 25,
    "speed_source": "ESTIMATE - no 1854-56 timetable read. Set a little below the 32 km/h the company's own 1868-69 ad implies (Algiers 8 a.m. - Brashear City noon, 80 mi).",
    "geometry_source": "Copy of the first 52.0 mi of mlt-algiers-morgan-city (OSM-traced), cut by distance from Algiers.",
    "geometry_quality": "Real-traced (via the Morgan's trace), no straight-line legs added. Drawn 52.0 mi against 52 mi documented (ICC: 'On November 6, 1854, a line extending 52 miles from Algiers was opened'). The western end is cut at 52.0 mi along the traced line, about 0.4 mi from where OSM puts Lafourche Crossing; the exact 1854 railhead/station site was not located. Geometry copied programmatically from data/morgan_s_louisiana_and_texas_railroad_and_steamship_company.geojson feature mlt-algiers-morgan-city (same rails, successor operator), which is real-traced from OSM on the ORIGINAL west-bank alignment Algiers - Gretna - Westwego - Avondale, not the post-1935 Huey P. Long Bridge route. That trace's own caveats carry over: the Algiers end (about 3 mi through Algiers and Gretna) follows a razed grade and a river trail, and the Algiers terminal point is APPROXIMATE (the depot/ferry slip opposite Elysian Fields Ave was not located). LATER ALIGNMENT: drawn on the grade as OSM records it today; the 1874-75 track raising and any realignment since the 1850s were not checked.",
    "documented_mileage": 52,
    "traced_mileage": 52.0,
    "segments": [
     {
      "start": 1854,
      "end": 1856,
      "headway_min": 1440,
      "note": "Algiers (ferry from New Orleans) - Lafourche Crossing, the first 52 mi of the 5 ft 6 in gauge steam road. A ceremonial first train ran 3 Dec 1853 to the end of track about 17 mi out; regular service from about March 1854; the full 52 mi opened 6 Nov 1854 (ICC). Ends in 1856 because from the 12 Apr 1857 opening to Brashear the whole line is drawn by noogw-algiers-brashear. Intermediate sections west of Lafourche Crossing opened during 1855-56 but are not dated, so they are not drawn before 1857. Headway 1440 is an ESTIMATE (one train a day each way assumed); no 1850s timetable frequency was read.",
      "sources": [
       "Segment-level: opening dates from the ICC valuation and Friedman's gauge history; first-train and 'about March 1854' from Friedman. Headway not sourced.",
       "https://en.wikipedia.org/wiki/Wikipedia:WikiProject_Trains/ICC_valuations/Morgan%27s_Louisiana_and_Texas_Railroad_and_Steamship_Company",
       "https://friedman.cs.illinois.edu/app3/Page__f.htm"
      ]
     }
    ]
   }
